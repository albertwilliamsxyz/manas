{
  "scripts": {
    "build:purs": "purs compile 'src/**/*.purs' '.spago/p/*/src/**/*.purs' --output output",
    "bundle": "esbuild output/Main/index.js --bundle --outfile=dist/app.js --format=iife --global-name=PS --footer:js='PS.main();'",
    "build": "npm run build:purs && npm run bundle",
    "dev": "npm run build && node dev-server.mjs",
    "dev:host": "npm run build && node dev-server.mjs --host"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "dependencies": {}
}
