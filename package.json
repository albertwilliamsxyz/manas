{
  "name": "manas",
  "version": "1.0.0",
  "description": "A spatial mathematical instrument: a browser-native, hand-tracked WebXR/AR engine written in PureScript with WebGL2.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "build": "spago bundle --module Main --outfile dist/main.js --platform browser",
    "serve": "npx --yes serve . -p 3000",
    "serve:https": "node serve-https.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/albertwilliamsxyz/manas.git"
  },
  "keywords": [
    "webxr",
    "webgl2",
    "purescript",
    "augmented-reality",
    "hand-tracking",
    "functional-programming"
  ],
  "author": "Albert Williams",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/albertwilliamsxyz/manas/issues"
  },
  "homepage": "https://github.com/albertwilliamsxyz/manas#readme",
  "devDependencies": {
    "esbuild": "^0.27.3",
    "purescript": "^0.15.15",
    "spago": "^1.0.4"
  }
}
